{
    "tasks": {
        "start": "deno run --allow-net --allow-env --allow-read --env-file=.env app.ts",
        "dev": "deno run --watch --allow-net --allow-env --allow-read --env-file=.env app.ts",
        "lint": "deno lint",
        "check": "deno check app.ts"
    },
    "imports": {
        "express": "npm:express@4.18.2",
        "cors": "npm:cors@2.8.5",
        "ldapjs": "npm:ldapjs@3.0.5"
    },
    "lint": {
        "exclude": ["static/"]
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120,
        "semiColons": true,
        "singleQuote": false
    }
}
