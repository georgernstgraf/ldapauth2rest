{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "runtimeExecutable": "deno",
            "runtimeArgs": [
                "run",
                "--inspect-wait",
                "--allow-net",
                "--allow-env",
                "--allow-read",
                "--env-file=.env"
            ],
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/app.ts"
        }
    ]
}
